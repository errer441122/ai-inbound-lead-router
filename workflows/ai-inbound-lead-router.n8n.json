{
  "name": "AI Inbound Lead Enrichment, ICP Scoring & HubSpot Routing",
  "nodes": [
    {
      "id": "1",
      "name": "Webhook: Inbound Form + UTMs",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "webhookId": "a1b2c3d4-1111-4000-8000-000000000001",
      "position": [
        160,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "inbound-lead-router",
        "responseMode": "onReceived",
        "options": {}
      },
      "notes": "Receives form submit payload: email, first_name, company_name, message, utm_source, utm_medium, utm_campaign, page_url."
    },
    {
      "id": "2",
      "name": "Normalize Lead & Extract Domain",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        400,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "email",
              "value": "={{ ($json.body.email || '').trim().toLowerCase() }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "domain",
              "value": "={{ (($json.body.email || '').trim().toLowerCase().split('@')[1]) || '' }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "utm_source",
              "value": "={{ ($json.body.utm_source || 'direct').trim().toLowerCase() }}",
              "type": "string"
            },
            {
              "id": "a4",
              "name": "utm_medium",
              "value": "={{ ($json.body.utm_medium || 'none').trim().toLowerCase() }}",
              "type": "string"
            },
            {
              "id": "a5",
              "name": "utm_campaign",
              "value": "={{ ($json.body.utm_campaign || 'unattributed').trim().toLowerCase() }}",
              "type": "string"
            },
            {
              "id": "a6",
              "name": "message",
              "value": "={{ ($json.body.message || '').trim() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "3",
      "name": "Guard: Corporate Email Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        640,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ ['gmail.com','yahoo.com','hotmail.com','outlook.com','libero.it','icloud.com','proton.me'].includes($json.domain) }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.domain }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ]
        },
        "options": {}
      },
      "notes": "Free personal domains skip enrichment & AI scoring to prevent credit waste and route to self-serve nurture."
    },
    {
      "id": "4",
      "name": "HubSpot: Route Free Email (Self-Serve)",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [
        880,
        500
      ],
      "parameters": {
        "resource": "contact",
        "operation": "upsert",
        "email": "={{ $json.email }}",
        "additionalFields": {
          "customPropertiesUi": {
            "customPropertiesValues": [
              {
                "property": "icp_tier",
                "value": "Tier 3 - Free Email"
              },
              {
                "property": "routing_status",
                "value": "self_serve_nurture"
              },
              {
                "property": "last_touch_utm_source",
                "value": "={{ $json.utm_source }}"
              },
              {
                "property": "last_touch_utm_medium",
                "value": "={{ $json.utm_medium }}"
              },
              {
                "property": "last_touch_utm_campaign",
                "value": "={{ $json.utm_campaign }}"
              }
            ]
          }
        },
        "authentication": "appToken"
      },
      "notes": "Updates all three last_touch_utm_* fields without overwriting any existing first_touch_utm_* fields."
    },
    {
      "id": "5",
      "name": "HubSpot: Search Existing Contact",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [
        880,
        220
      ],
      "alwaysOutputData": true,
      "parameters": {
        "resource": "contact",
        "operation": "search",
        "filterGroupsUi": {
          "filterGroupsValues": [
            {
              "filtersUi": {
                "filterValues": [
                  {
                    "propertyName": "email",
                    "operator": "EQ",
                    "value": "={{ $json.email }}"
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "properties": [
            "email",
            "first_touch_utm_source",
            "first_touch_utm_medium",
            "first_touch_utm_campaign",
            "lifecyclestage"
          ]
        },
        "authentication": "appToken",
        "returnAll": false,
        "limit": 1
      },
      "notes": "alwaysOutputData=true prevents brand-new leads (0 search matches) from halting the workflow. Explicitly requests all 3 first_touch_utm_* custom properties."
    },
    {
      "id": "6",
      "name": "HTTP: Fetch Public Homepage Context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        220
      ],
      "continueOnFail": true,
      "parameters": {
        "url": "=https://{{ $('Normalize Lead & Extract Domain').item.json.domain }}",
        "options": {
          "timeout": 8000,
          "redirect": {
            "redirect": {
              "followRedirects": true,
              "maxRedirects": 3
            }
          },
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "notes": "Lightweight public website lookup. continueOnFail=true ensures unreachable domains route to human review instead of dropping the lead."
    },
    {
      "id": "7",
      "name": "AI: Structured ICP Qualification (JSON)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1360,
        220
      ],
      "continueOnFail": true,
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gpt-4o-mini', temperature: 0.1, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: 'You are a B2B Marketing Operations ICP qualifier. Classify the company using ONLY the provided domain, website snippet, and inbound message. Return strictly JSON with keys: icp_tier (Tier 1 | Tier 2 | Tier 3), confidence_score (0-100), business_model, industry, reasoning (1 sentence), personalized_hook (1 factual sentence), risk_flags (array). If website data is missing or ambiguous, set confidence_score below 75.' }, { role: 'user', content: JSON.stringify({ domain: $('Normalize Lead & Extract Domain').item.json.domain, inbound_message: $('Normalize Lead & Extract Domain').item.json.message, homepage_excerpt: String($json.data || '').replace(/<[^>]+>/g, ' ').slice(0, 2500) }) } ] }) }}"
      },
      "notes": "Low temperature (0.1) + strict JSON object contract. Can also point to Google Gemini OpenAI-compatible endpoint; see prompts/icp-scoring-prompt.md."
    },
    {
      "id": "8",
      "name": "Parse AI ICP Output (Safe Defaults)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        220
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = String(\n  $json.choices?.[0]?.message?.content ||\n  $json.candidates?.[0]?.content?.parts?.[0]?.text ||\n  '{}'\n).replace(/```json|```/g, '').trim();\n\nlet parsed = {};\ntry {\n  parsed = JSON.parse(raw);\n} catch (err) {\n  parsed = { risk_flags: ['ai_parse_error'] };\n}\n\nreturn {\n  json: {\n    icp_tier: parsed.icp_tier || 'Tier 2',\n    confidence_score: Number(parsed.confidence_score) || 0,\n    reasoning: parsed.reasoning || 'AI output missing or unparseable — routed to human review.',\n    personalized_hook: parsed.personalized_hook || '',\n    risk_flags: Array.isArray(parsed.risk_flags) ? parsed.risk_flags.join(', ') : ''\n  }\n};"
      },
      "notes": "Real JavaScript Code node (n8n Community-safe try/catch). Supports OpenAI & Gemini outputs; malformed/timeout responses default confidence_score to 0 -> needs_human_review."
    },
    {
      "id": "9",
      "name": "Guard: AI Confidence >= 80%",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1840,
        220
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "g1",
              "leftValue": "={{ $json.confidence_score }}",
              "rightValue": 80,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ]
        },
        "options": {}
      },
      "notes": "Human-in-the-loop guardrail: low-confidence (<80) or failed AI responses NEVER auto-route to Sales."
    },
    {
      "id": "10",
      "name": "HubSpot: Flag Needs Manual Review",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [
        2100,
        420
      ],
      "parameters": {
        "resource": "contact",
        "operation": "upsert",
        "email": "={{ $('Normalize Lead & Extract Domain').item.json.email }}",
        "additionalFields": {
          "customPropertiesUi": {
            "customPropertiesValues": [
              {
                "property": "routing_status",
                "value": "needs_human_review"
              },
              {
                "property": "ai_confidence_score",
                "value": "={{ $json.confidence_score }}"
              },
              {
                "property": "ai_icp_reasoning",
                "value": "={{ $json.reasoning }}"
              },
              {
                "property": "first_touch_utm_source",
                "value": "={{ $('HubSpot: Search Existing Contact').first()?.json?.properties?.first_touch_utm_source || $('Normalize Lead & Extract Domain').item.json.utm_source }}"
              },
              {
                "property": "first_touch_utm_medium",
                "value": "={{ $('HubSpot: Search Existing Contact').first()?.json?.properties?.first_touch_utm_medium || $('Normalize Lead & Extract Domain').item.json.utm_medium }}"
              },
              {
                "property": "first_touch_utm_campaign",
                "value": "={{ $('HubSpot: Search Existing Contact').first()?.json?.properties?.first_touch_utm_campaign || $('Normalize Lead & Extract Domain').item.json.utm_campaign }}"
              },
              {
                "property": "last_touch_utm_source",
                "value": "={{ $('Normalize Lead & Extract Domain').item.json.utm_source }}"
              },
              {
                "property": "last_touch_utm_medium",
                "value": "={{ $('Normalize Lead & Extract Domain').item.json.utm_medium }}"
              },
              {
                "property": "last_touch_utm_campaign",
                "value": "={{ $('Normalize Lead & Extract Domain').item.json.utm_campaign }}"
              }
            ]
          }
        },
        "authentication": "appToken"
      }
    },
